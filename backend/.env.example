# Copy this file to backend/.env and fill in your values. Never commit the real .env.

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# LLM API key (Groq recommended — free at console.groq.com; OpenAI also supported)
GROQ_API_KEY=your_groq_key_here
# OPENAI_API_KEY=your_openai_key_here

# JWT — secret used to sign auth tokens. Use any long random string.
JWT_SECRET=replace_with_a_long_random_string
# JWT_EXPIRES_IN=7d

# Server
PORT=3001
